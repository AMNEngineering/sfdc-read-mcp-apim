<policies>
    <inbound>
        <base />

        <!-- Validate Entra ID JWT and require MCP.Read role -->
        <validate-azure-ad-token tenant-id="${tenant_id}">
            <audiences>
                <audience>api://{{SFDC-Read-MCP-App-ID}}</audience>
            </audiences>
        </validate-azure-ad-token>

        <!-- Verify user has MCP.Read app role -->
        <choose>
            <when condition="@{
                var token = context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;,&quot;&quot;).Split(' ')[1].AsJwt();
                var roles = token?.Claims.GetValueOrDefault(&quot;roles&quot;, null);
                return roles == null || !roles.Contains(&quot;MCP.Read&quot;);
            }">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-body>{"error": "User does not have MCP.Read role"}</set-body>
                </return-response>
            </when>
        </choose>

        <!-- Extract user identity for audit trail -->
        <set-variable name="userOid" value="@(context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;,&quot;&quot;).Split(' ')[1].AsJwt()?.Claims.GetValueOrDefault(&quot;oid&quot;, &quot;&quot;))" />
        <set-header name="x-apim-user-id" exists-action="override">
            <value>@((string)context.Variables[&quot;userOid&quot;])</value>
        </set-header>

        <!-- Correlation ID for tracing -->
        <set-variable name="correlationId" value="@(context.Request.Headers.GetValueOrDefault(&quot;x-correlation-id&quot;, Guid.NewGuid().ToString()))" />
        <set-header name="x-correlation-id" exists-action="override">
            <value>@((string)context.Variables[&quot;correlationId&quot;])</value>
        </set-header>

        <!-- Resolve named values into context variables for Salesforce OAuth -->
        <set-variable name="sfClientId" value="{{SFDC-MCP-Client-ID}}" />
        <set-variable name="sfClientSecret" value="{{SFDC-MCP-Client-Secret}}" />
        <set-variable name="sfTokenUrl" value="{{SFDC-MCP-Token-URL}}" />
        <set-variable name="sfMcpBaseUrl" value="{{SFDC-MCP-Base-URL}}" />
        <set-variable name="sfMcpPath" value="{{SFDC-MCP-Path}}" />

        <!-- Salesforce OAuth token exchange (client_credentials) -->
        <send-request mode="new" response-variable-name="sfTokenResponse" timeout="10" ignore-error="false">
            <set-url>@((string)context.Variables[&quot;sfTokenUrl&quot;])</set-url>
            <set-method>POST</set-method>
            <set-header name="Content-Type" exists-action="override">
                <value>application/x-www-form-urlencoded</value>
            </set-header>
            <set-body>@{
                var clientId = (string)context.Variables[&quot;sfClientId&quot;];
                var clientSecret = (string)context.Variables[&quot;sfClientSecret&quot;];
                return String.Format(&quot;grant_type=client_credentials&amp;client_id={0}&amp;client_secret={1}&quot;,
                    Uri.EscapeDataString(clientId), Uri.EscapeDataString(clientSecret));
            }</set-body>
        </send-request>

        <!-- Extract Salesforce access token -->
        <set-variable name="sfAccessToken" value="@(((IResponse)context.Variables[&quot;sfTokenResponse&quot;]).Body.As&lt;JObject&gt;()[&quot;access_token&quot;].ToString())" />

        <!-- Route to Salesforce MCP endpoint (api.salesforce.com, not instance_url) -->
        <set-backend-service base-url="@((string)context.Variables[&quot;sfMcpBaseUrl&quot;] + (string)context.Variables[&quot;sfMcpPath&quot;])" />

        <!-- Replace inbound Entra JWT with Salesforce bearer token -->
        <set-header name="Authorization" exists-action="override">
            <value>@(&quot;Bearer &quot; + (string)context.Variables[&quot;sfAccessToken&quot;])</value>
        </set-header>
    </inbound>

    <backend>
        <base />
    </backend>

    <outbound>
        <base />
    </outbound>

    <on-error>
        <base />
    </on-error>
</policies>
