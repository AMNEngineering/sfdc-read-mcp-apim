<policies>
    <inbound>
        <base />

        <!-- Validate Entra ID JWT and require MCP.Read role.
             Accept both audience formats:
               - api://{guid}  — issued when a client requests "api://{guid}/.default"
                 (typical for service-to-service / .default scope flows, including the
                 APIM-fronted OAuth2 auth-server used by Power Automate / Copilot Studio
                 when the connector's Resource URL is set to api://{guid}).
               - {guid}        — issued when the client app is the same as the resource
                 app (self-OAuth) and Entra rejects api://{guid} with AADSTS90009, so
                 the Power Platform connector's Resource URL is configured as the bare
                 GUID. Entra then mints tokens with aud={guid} (no api:// prefix). -->
        <validate-azure-ad-token tenant-id="${tenant_id}">
            <audiences>
                <audience>api://{{SFDC-Read-MCP-App-ID}}</audience>
                <audience>{{SFDC-Read-MCP-App-ID}}</audience>
            </audiences>
        </validate-azure-ad-token>

        <!-- Verify user has MCP.Read app role -->
        <choose>
            <when condition='@{
                var token = context.Request.Headers.GetValueOrDefault("Authorization","").Split(Convert.ToChar(32))[1].AsJwt();
                var roles = token != null && token.Claims.ContainsKey("roles") ? token.Claims["roles"] : null;
                return roles == null || !roles.Contains("MCP.Read");
            }'>
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-body>{"error": "User does not have MCP.Read role"}</set-body>
                </return-response>
            </when>
        </choose>

        <!-- Extract user identity for audit trail -->
        <set-variable name="userOid" value='@{
            var token = context.Request.Headers.GetValueOrDefault("Authorization","").Split(Convert.ToChar(32))[1].AsJwt();
            return token != null && token.Claims.ContainsKey("oid") && token.Claims["oid"] != null && token.Claims["oid"].Length &gt; 0 ? token.Claims["oid"][0] : string.Empty;
        }' />
        <set-header name="x-apim-user-id" exists-action="override">
            <value>@((string)context.Variables["userOid"])</value>
        </set-header>

        <!-- Correlation ID for tracing -->
        <set-variable name="correlationId" value='@(context.Request.Headers.GetValueOrDefault("x-correlation-id", Guid.NewGuid().ToString()))' />
        <set-header name="x-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
        </set-header>

        <!-- Parse MCP request for protocol-aware handling on POST endpoints -->
        <set-variable name="requestBody" value='@(context.Request.Method == "POST" ? context.Request.Body.As&lt;JObject&gt;(preserveContent: true) : new JObject())' />
        <set-variable name="mcpMethod" value='@(((JObject)context.Variables["requestBody"])["method"]?.ToString())' />
        <set-variable name="mcpId" value='@(((JObject)context.Variables["requestBody"])["id"])' />

        <!-- Handle notifications and reject unsupported JSON-RPC methods in APIM -->
        <choose>
            <when condition='@(((string)context.Variables["mcpMethod"]) == "notifications/initialized")'>
                <return-response>
                    <set-status code="202" reason="Accepted" />
                    <set-header name="x-correlation-id" exists-action="override">
                        <value>@((string)context.Variables["correlationId"])</value>
                    </set-header>
                </return-response>
            </when>
            <when condition='@(
                context.Request.Method == "POST"
                &amp;&amp; !string.IsNullOrEmpty((string)context.Variables["mcpMethod"])
                &amp;&amp; (string)context.Variables["mcpMethod"] != "initialize"
                &amp;&amp; (string)context.Variables["mcpMethod"] != "tools/list"
                &amp;&amp; (string)context.Variables["mcpMethod"] != "tools/call"
                &amp;&amp; (string)context.Variables["mcpMethod"] != "notifications/initialized"
            )'>
                <return-response>
                    <set-status code="200" reason="OK" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-header name="x-correlation-id" exists-action="override">
                        <value>@((string)context.Variables["correlationId"])</value>
                    </set-header>
                    <set-body>@{
                        var methodName = (string)context.Variables["mcpMethod"];
                        return new JObject(
                            new JProperty("jsonrpc", "2.0"),
                            new JProperty("id", context.Variables["mcpId"]),
                            new JProperty("error", new JObject(
                                new JProperty("code", -32601),
                                new JProperty("message", "Method not found"),
                                new JProperty("data", "Method '" + methodName + "' is not supported")
                            ))
                        ).ToString();
                    }</set-body>
                </return-response>
            </when>
        </choose>

        <!-- Resolve named values into context variables for Salesforce OAuth -->
        <set-variable name="sfClientId" value="{{SFDC-MCP-Client-ID}}" />
        <set-variable name="sfClientSecret" value="{{SFDC-MCP-Client-Secret}}" />
        <set-variable name="sfTokenUrl" value="{{SFDC-MCP-Token-URL}}" />
        <set-variable name="sfMcpBaseUrl" value="{{SFDC-MCP-Base-URL}}" />
        <set-variable name="sfMcpPath" value="{{SFDC-MCP-Path}}" />

        <!-- Cache lookup: avoid a token request on every call (TTL 30 min, keyed on client_id) -->
        <cache-lookup-value key='@("sfdc-mcp-token-" + (string)context.Variables["sfClientId"])' variable-name="sfAccessToken" />

        <!-- Only exchange token if cache miss -->
        <choose>
            <when condition='@(!context.Variables.ContainsKey("sfAccessToken") || string.IsNullOrEmpty((string)context.Variables["sfAccessToken"]))'>
                <!-- Salesforce OAuth token exchange (client_credentials) -->
                <!-- Set ignore-error=true so we can return shaped JSON-RPC error instead of APIM default -->
                <send-request mode="new" response-variable-name="sfTokenResponse" timeout="10" ignore-error="true">
                    <set-url>@((string)context.Variables["sfTokenUrl"])</set-url>
                    <set-method>POST</set-method>
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/x-www-form-urlencoded</value>
                    </set-header>
                    <set-body>@{
                        var clientId = (string)context.Variables["sfClientId"];
                        var clientSecret = (string)context.Variables["sfClientSecret"];
                        return String.Format("grant_type=client_credentials&amp;client_id={0}&amp;client_secret={1}",
                            Uri.EscapeDataString(clientId), Uri.EscapeDataString(clientSecret));
                    }</set-body>
                </send-request>

                <!-- Token failure: return JSON-RPC -32603 -->
                <choose>
                    <when condition='@(((IResponse)context.Variables["sfTokenResponse"]).StatusCode != 200)'>
                        <return-response>
                            <set-status code="200" reason="OK" />
                            <set-header name="Content-Type" exists-action="override">
                                <value>application/json</value>
                            </set-header>
                            <set-header name="x-correlation-id" exists-action="override">
                                <value>@((string)context.Variables["correlationId"])</value>
                            </set-header>
                            <set-body>@{
                                return new JObject(
                                    new JProperty("jsonrpc", "2.0"),
                                    new JProperty("id", context.Variables["mcpId"]),
                                    new JProperty("error", new JObject(
                                        new JProperty("code", -32603),
                                        new JProperty("message", "Internal error"),
                                        new JProperty("data", "Salesforce token exchange failed. x-correlation-id: " + (string)context.Variables["correlationId"])
                                    ))
                                ).ToString();
                            }</set-body>
                        </return-response>
                    </when>
                </choose>

                <!-- Store token in cache for 30 minutes -->
                <set-variable name="sfAccessToken" value='@(((IResponse)context.Variables["sfTokenResponse"]).Body.As&lt;JObject&gt;()["access_token"].ToString())' />
                <cache-store-value key='@("sfdc-mcp-token-" + (string)context.Variables["sfClientId"])' value='@((string)context.Variables["sfAccessToken"])' duration="1800" />
            </when>
        </choose>

        <!-- Route to Salesforce MCP endpoint (api.salesforce.com, not instance_url) -->
        <set-backend-service base-url='@((string)context.Variables["sfMcpBaseUrl"] + (string)context.Variables["sfMcpPath"])' />

        <!-- Strip the operation's url_template segment (e.g. /mcp on mcp-post/get/delete,
             / on invoke-mcp-legacy) before forwarding to the SF backend. Without this,
             APIM appends the operation segment to the base-url, producing
             .../sobject-reads/mcp — which SF's MCP server returns 404 for.
             The working SF endpoint per docs/SALESFORCE-MCP-INTEGRATION-REFERENCE.md is
             /platform/mcp/v1/sandbox/platform/sobject-reads with no trailing segment.
             rewrite-uri template="/" overrides the request URI to "/" so the final
             backend URL becomes <base-url>/ — SF accepts the trailing slash. -->
        <rewrite-uri template="/" copy-unmatched-params="false" />

        <!-- Replace inbound Entra JWT with Salesforce bearer token -->
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["sfAccessToken"])</value>
        </set-header>
    </inbound>

    <backend>
        <base />
    </backend>

    <outbound>
        <base />
    </outbound>

    <on-error>
        <base />
        <!-- Return JSON-RPC -32603 internal error envelope for any unhandled exception -->
        <set-variable name="errorCorrelationId" value='@(context.Variables.ContainsKey("correlationId") ? (string)context.Variables["correlationId"] : Guid.NewGuid().ToString())' />
        <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
        </set-header>
        <set-header name="x-correlation-id" exists-action="override">
            <value>@((string)context.Variables["errorCorrelationId"])</value>
        </set-header>
        <set-body>@{
            var errorMcpId = context.Variables.ContainsKey("mcpId") ? context.Variables["mcpId"] : null;
            return new JObject(
                new JProperty("jsonrpc", "2.0"),
                new JProperty("id", errorMcpId),
                new JProperty("error", new JObject(
                    new JProperty("code", -32603),
                    new JProperty("message", "Internal error"),
                    new JProperty("data", "x-correlation-id: " + (string)context.Variables["errorCorrelationId"])
                ))
            ).ToString();
        }</set-body>
        <set-status code="200" reason="OK" />
    </on-error>
</policies>
