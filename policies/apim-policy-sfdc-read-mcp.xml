<policies>
    <inbound>
        <base />

        <!-- Validate Entra ID JWT -->
        <validate-azure-ad-token tenant-id="${tenant_id}">
            <client-application-ids>
                <application-id>{{sfdc-read-mcp-app-id}}</application-id>
            </client-application-ids>
            <audiences>
                <audience>api://{{sfdc-read-mcp-app-id}}</audience>
            </audiences>
        </validate-azure-ad-token>

        <!-- Extract user identity for audit trail -->
        <set-variable name="userOid" value="@(context.Request.Headers.GetValueOrDefault("Authorization","").Split(' ')[1].AsJwt()?.Claims.GetValueOrDefault("oid", ""))" />
        <set-header name="x-apim-user-id" exists-action="override">
            <value>@((string)context.Variables["userOid"])</value>
        </set-header>

        <!-- Correlation ID for tracing -->
        <set-variable name="correlationId" value="@(context.Request.Headers.GetValueOrDefault("x-correlation-id", Guid.NewGuid().ToString()))" />
        <set-header name="x-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
        </set-header>

        <!-- Salesforce OAuth token exchange (client_credentials) -->
        <send-request mode="new" response-variable-name="sfTokenResponse" timeout="10" ignore-error="false">
            <set-url>{{nv-sfdc-read-mcp-token-url}}</set-url>
            <set-method>POST</set-method>
            <set-header name="Content-Type" exists-action="override">
                <value>application/x-www-form-urlencoded</value>
            </set-header>
            <set-body>@{
                return "grant_type=client_credentials"
                    + "&amp;client_id={{nv-sfdc-read-mcp-client-id}}"
                    + "&amp;client_secret={{nv-sfdc-read-mcp-client-secret}}";
            }</set-body>
        </send-request>

        <!-- Extract Salesforce access token and instance URL -->
        <set-variable name="sfAccessToken" value="@(((IResponse)context.Variables["sfTokenResponse"]).Body.As&lt;JObject&gt;()["access_token"].ToString())" />
        <set-variable name="sfInstanceUrl" value="@(((IResponse)context.Variables["sfTokenResponse"]).Body.As&lt;JObject&gt;()["instance_url"].ToString())" />

        <!-- Route to the Salesforce instance returned by OAuth -->
        <set-backend-service base-url="@((string)context.Variables["sfInstanceUrl"] + "{{nv-sfdc-read-mcp-path}}")" />

        <!-- Replace inbound Entra JWT with Salesforce bearer token -->
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["sfAccessToken"])</value>
        </set-header>
    </inbound>

    <backend>
        <base />
    </backend>

    <outbound>
        <base />
    </outbound>

    <on-error>
        <base />
    </on-error>
</policies>
